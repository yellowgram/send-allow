# Send Allow — copy to .env (never commit .env)
#
# Non-custodial JSON-RPC gate: allowlist + optional native caps.
# No simulation. For sim-before-send see L2 Send Guard (l2-send-guard).
# Testnet / self-host only. No mainnet SLA.

# Listen. 127.0.0.1 is the default. 0.0.0.0 without an ACL is an
# unauthenticated forwarder onto your upstream RPC.
SEND_ALLOW_HOST=127.0.0.1
SEND_ALLOW_PORT=8546

# Required: upstream JSON-RPC URL (the RPC you already use).
SEND_ALLOW_UPSTREAM_RPC=https://sepolia.base.org

# Policy file (copy policy.agent.example.json → policy.json and replace placeholders).
SEND_ALLOW_POLICY_ENABLED=true
SEND_ALLOW_POLICY_FILE=./policy.json

# Undecodable raw: fail_open (default, forward) | fail_closed (abort -32083).
# Definite policy misses (not allowlisted / over cap) ALWAYS fail-closed.
SEND_ALLOW_UNDECODABLE_MODE=fail_open

# Optional JSONL decision log.
# SEND_ALLOW_DECISION_LOG=./decisions.jsonl

# Optional env shortcuts (merged with file when set):
# SEND_ALLOW_ALLOWLIST=0xabc…,0xdef…
# SEND_ALLOW_GLOBAL_MAX_WEI=50000000000000000
# SEND_ALLOW_ALLOW_CREATE=false
# SEND_ALLOW_ALLOW_ANY=false
